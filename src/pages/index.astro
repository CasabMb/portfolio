---
import '../styles/Global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Apropos from '../components/Apropos.astro';
import Services from '../components/Services.astro';
import Contact from '../components/Contact.astro';
import ProjetsRecents from '../components/ProjetsRecents.astro';
import Engagements from '../components/Engagements.astro';
import Probleme from '../components/Probleme.astro';

export const prerender = true;

const title = "Marie Casabianca | Développeuse web front-end";
const description = "Développeuse web front-end, je crée des interfaces modernes, responsive et soignées. Découvrez mon portfolio, mes projets web et mes compétences en HTML, CSS, JavaScript, Astro et React.";
---

<Layout {title} {description}>
	<Header />
	<Hero />
	<Probleme />
	<Services />
	<Apropos />
	<ProjetsRecents />
	<Engagements />
	<Contact />
	<Footer />
</Layout>
