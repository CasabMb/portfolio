---
import '../styles/404.css';
import '../styles/Global.css';
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const title = "Page introuvable | Portfolio";
const homeUrl = import.meta.env.BASE_URL;
const projectsUrl = `${import.meta.env.BASE_URL}#projets-recents`;
---

<Layout {title}>
    <section class="error-404">
        <div class="error-404__bg"></div>

        <div class="error-404__card">
            <p class="error-404__signature">
                Portfolio <span class="signature">developpeuse Web</span>
            </p>

            <span class="error-404__pill">Erreur 404</span>

            <h1>Oups, cette page n’existe pas</h1>

            <p class="error-404__intro">
                Le lien que vous avez suivi semble incorrect ou la page a été déplacée.
            </p>

            <p class="error-404__text">
                Vous pouvez revenir à l’accueil pour découvrir mon univers, mes projets web,
                mes compétences en <span>HTML</span>, <span>CSS</span>,
                <span>JavaScript</span> et mes créations digitales.
            </p>

            <div class="error-404__buttons">
                <a href={homeUrl} class="error-404__btn error-404__btn--primary">
                Retour à l’accueil
                </a>

                <a href={projectsUrl} class="error-404__btn error-404__btn--secondary">
                Voir mes projets
                </a>
            </div>
        </div>
    </section>
</Layout>